# Copy to .env (git-ignored) and adjust. scripts/run.sh and compose.yaml load it.

# Ollama endpoint (OpenAI-compatible /v1). On the host: http://localhost:11434/v1
# From a container talking to the host: http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Models: Ollama CLOUD models only (names end in ":cloud" or "-cloud").
# They run on ollama.com, need `ollama signin` and internet, and receive
# your prompts and profiles: use sanitized inputs only. Local models are
# refused (exit 64) unless ALLOW_LOCAL_MODELS=1.
# The judge uses a different model family so it does not share the
# researcher's / specialists' blind spots.
RESEARCH_MODEL=nemotron-3-super:cloud
JUDGE_MODEL=gpt-oss:120b-cloud
WRITER_MODEL=nemotron-3-super:cloud
ROUTER_MODEL=nemotron-3-super:cloud
# Guardrail policy generator: small model for the 7 category specialists,
# larger model for the assembler and reviewer.
SPECIALIST_MODEL=nemotron-3-nano:30b-cloud
REVIEWER_MODEL=nemotron-3-super:cloud
# Specialists run in parallel (default 4, max 7). Rate-limit and connection
# errors are retried 3 times with exponential backoff starting here.
GUARDRAIL_PARALLEL=4
GUARDRAIL_BACKOFF_SECONDS=5
# ALLOW_LOCAL_MODELS=0

# Default agent config and docker-agent safety level.
CFG=agents/prisma-cortex-hub.yaml
SAFETY=restricted

# --- Optional: read-only tenant assistant (scripts/gen-tenant-config.sh) ---
# Use a READ-ONLY service account / API key. Never commit real values.
# Prisma Cloud: API URL for your stack (see https://pan.dev/prisma-cloud/api/cspm/api-urls/)
PRISMA_API_URL=https://api.prismacloud.io
PRISMA_ACCESS_KEY=
PRISMA_SECRET_KEY=
# Filled in by: eval "$(scripts/prisma-login.sh)"
PRISMA_TOKEN=
# Cortex Cloud: tenant FQDN without "api-" (e.g. mytenant.xdr.us.paloaltonetworks.com),
# standard API key and its ID.
CORTEX_FQDN=
CORTEX_API_KEY=
CORTEX_API_KEY_ID=

# compose.yaml only. Your host user, so the container can write ./outputs:
# HOST_UID=1000   # id -u
# HOST_GID=1000   # id -g
# Ollama URL as seen from inside the container.
# CONTAINER_OLLAMA_BASE_URL=http://ollama:11434/v1
