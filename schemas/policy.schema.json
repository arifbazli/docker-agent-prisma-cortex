{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy.schema.json",
  "title": "Generated AI guardrail policy (canonical, advisory)",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "advisory",
    "catalog_version",
    "profile",
    "controls",
    "waivers",
    "excluded"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "generator": {
      "type": "string",
      "enum": [
        "guardrail-policy-generator"
      ]
    },
    "advisory": {
      "type": "boolean",
      "enum": [
        true
      ],
      "description": "Output is advisory and needs human review."
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "object",
      "description": "The sanitized app profile the policy was generated for (validated separately against app-profile.schema.json)."
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "control_id",
          "category",
          "name",
          "severity",
          "enforcement_point",
          "targets",
          "tier",
          "parameters"
        ],
        "additionalProperties": false,
        "properties": {
          "control_id": {
            "type": "string",
            "pattern": "^(INPUT|PROMPT|RETRIEVAL|TOOL|OUTPUT|RUNTIME|MEMORY)-(0[1-9]|10)$"
          },
          "category": {
            "type": "string",
            "enum": [
              "input",
              "prompt",
              "retrieval",
              "tool",
              "output",
              "runtime",
              "memory"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "enforcement_point": {
            "type": "string",
            "enum": [
              "pre_model",
              "prompt_assembly",
              "retrieval_pipeline",
              "tool_gateway",
              "post_model",
              "runtime_monitor",
              "memory_store"
            ]
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "generic",
                "bedrock",
                "nemo"
              ]
            }
          },
          "threats": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "value",
                "rationale",
                "source_url",
                "source_quote"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,59}$"
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "array"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "source_url": {
                  "type": "string",
                  "pattern": "^https://[^?#]+$"
                },
                "source_quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "description": "Only grounded parameters. Empty for catalog-default controls."
          },
          "tier": {
            "type": "string",
            "enum": [
              "grounded",
              "catalog-default"
            ],
            "description": "grounded = at least one parameter whose quote was found on the cited page by script AND judged SUPPORTED; catalog-default = filled by script from the catalog, no vendor source, no parameters."
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Every selected control, exactly once, with its evidence tier."
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "input",
              "prompt",
              "retrieval",
              "tool",
              "output",
              "runtime",
              "memory"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "control_id",
          "tier",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "control_id": {
            "type": "string",
            "pattern": "^(INPUT|PROMPT|RETRIEVAL|TOOL|OUTPUT|RUNTIME|MEMORY)-(0[1-9]|10)$"
          },
          "reason": {
            "type": "string",
            "minLength": 5
          },
          "tier": {
            "type": "string",
            "enum": [
              "excluded"
            ]
          }
        }
      },
      "description": "Every catalog control not selected for the profile, with the selection reason."
    }
  }
}
