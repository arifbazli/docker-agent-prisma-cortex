{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.schema.json",
  "title": "Guardrail control catalog",
  "type": "object",
  "required": [
    "catalog_version",
    "categories",
    "threats",
    "controls"
  ],
  "additionalProperties": false,
  "properties": {
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "$comment": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "prefix"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "input",
              "prompt",
              "retrieval",
              "tool",
              "output",
              "runtime",
              "memory"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "prefix": {
            "type": "string",
            "enum": [
              "INPUT",
              "PROMPT",
              "RETRIEVAL",
              "TOOL",
              "OUTPUT",
              "RUNTIME",
              "MEMORY"
            ]
          }
        }
      }
    },
    "threats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "framework",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(LLM(0[1-9]|10):2025|AML\\.T[0-9]{4}(\\.[0-9]{3})?)$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "framework": {
            "type": "string",
            "enum": [
              "OWASP LLM Top 10 2025",
              "MITRE ATLAS"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "name",
          "description",
          "applies_when",
          "threats",
          "enforcement_point",
          "supported_targets",
          "default_severity",
          "allowed_parameter_keys",
          "value_types",
          "recommended_defaults"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(INPUT|PROMPT|RETRIEVAL|TOOL|OUTPUT|RUNTIME|MEMORY)-(0[1-9]|10)$"
          },
          "category": {
            "type": "string",
            "enum": [
              "input",
              "prompt",
              "retrieval",
              "tool",
              "output",
              "runtime",
              "memory"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "applies_when": {
            "type": "object",
            "required": [
              "match",
              "conditions"
            ],
            "additionalProperties": false,
            "description": "match=all with no conditions means always.",
            "properties": {
              "match": {
                "type": "string",
                "enum": [
                  "all",
                  "any"
                ]
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "field",
                    "op"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "field": {
                      "type": "string",
                      "enum": [
                        "uses_rag",
                        "has_tools",
                        "tool_list",
                        "has_memory",
                        "handles_pii",
                        "user_facing",
                        "autonomy_level",
                        "cloud",
                        "data_classification",
                        "regulatory_context"
                      ]
                    },
                    "op": {
                      "type": "string",
                      "enum": [
                        "eq",
                        "ne",
                        "in",
                        "contains_any",
                        "nonempty"
                      ]
                    },
                    "value": {
                      "type": [
                        "boolean",
                        "string",
                        "array"
                      ]
                    }
                  }
                }
              }
            }
          },
          "threats": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(LLM(0[1-9]|10):2025|AML\\.T[0-9]{4}(\\.[0-9]{3})?)$"
            }
          },
          "enforcement_point": {
            "type": "string",
            "enum": [
              "pre_model",
              "prompt_assembly",
              "retrieval_pipeline",
              "tool_gateway",
              "post_model",
              "runtime_monitor",
              "memory_store"
            ]
          },
          "supported_targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "generic",
                "bedrock",
                "nemo"
              ]
            }
          },
          "default_severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "allowed_parameter_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,59}$"
            },
            "description": "The only parameter names a specialist may propose for this control."
          },
          "value_types": {
            "type": "object",
            "description": "One entry per allowed parameter key.",
            "additionalProperties": {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "boolean",
                    "number",
                    "string",
                    "enum",
                    "list"
                  ]
                },
                "enum": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "items_enum": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "quote_terms": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "recommended_defaults": {
            "type": "object",
            "description": "Opinionated, conservative baseline values (NOT vendor-backed). Keys must be allowed keys and values must match value_types.",
            "additionalProperties": {
              "type": [
                "boolean",
                "number",
                "string",
                "array"
              ]
            }
          }
        }
      }
    }
  }
}
